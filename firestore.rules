rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile Document
    match /users/{userId} {
      allow read, write: if (request.auth == null || request.auth.uid == userId) && isValidId(userId);

      // Journal Entries subcollection
      match /entries/{entryId} {
        allow read, write: if (request.auth == null || request.auth.uid == userId) && isValidId(userId) && isValidId(entryId);

        // Messages subcollection
        match /messages/{messageId} {
          allow read, write: if (request.auth == null || request.auth.uid == userId) && isValidId(userId) && isValidId(entryId) && isValidId(messageId);
        }
      }
    }
  }
}

